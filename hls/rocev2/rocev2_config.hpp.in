#pragma once
#include <stdint.h>

#define RETRANS_EN

const unsigned DATA_WIDTH = ${DATA_WIDTH} * 8;

const uint16_t MAX_QPS = ${ROCE_STACK_MAX_QPS};

const uint16_t PMTU = ${PMTU_BYTES}; //dividable by 8, 16, 32, 64
const uint16_t PMTU_WORDS = PMTU / (DATA_WIDTH/8);

// Network clock period (nclk) the stack is synthesized for, in ns. Used to convert between rates and cycles.
constexpr double CLOCK_PERIOD_NS = ${CLOCK_PERIOD};

// Congestion control
// Line rate of the link in Mb/s (rates are converted to inter-packet gaps relative to it)
const uint32_t CC_LINE_RATE_MBPS = ${CC_LINE_RATE_MBPS};
// CC module compiled into cc_unit (one of: DCQCN, IDENTITY)
#define CC_MODULE_${CC_MODULE}
// Echo CE marks of received data packets in their ACKs (BTH BECN bit). CNPs are sent independently
#cmakedefine EN_ACK_ECN

static const uint32_t PCIE_BATCH_PKG = 12;
static const uint32_t PCIE_BATCH_SIZE = PMTU * PCIE_BATCH_PKG;
